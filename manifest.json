{
  "manifest_version": 3,
  "name": "Locus",
  "version": "3.1.0",
  "description": "Turn scattered tabs into organized spaces - save, group, and rediscover tabs, notes, stacks, and reminders. No Locus account required.",
  "permissions": ["tabs", "storage", "contextMenus", "bookmarks", "alarms", "notifications", "favicon"],
  "optional_permissions": ["nativeMessaging"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:; connect-src 'none'"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Locus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+E" },
      "description": "Open Locus popup"
    },
    "save-current-tab": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Save current tab to Inbox"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
